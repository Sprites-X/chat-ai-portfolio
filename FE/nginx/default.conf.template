# ค่า ${PORT}, ${BE_URL} และ ${CHAT_RATE_PER_MIN} ถูกแทนตอน container เริ่ม (ตั้ง BE_URL ที่หน้า Environment ของ service FE บน Render)
# BE_URL ต้องขึ้นต้นด้วย https:// และห้ามมี / ท้าย เช่น https://chat-ai-portfolio-be.onrender.com

# จำกัดจำนวนคำถามต่อผู้ใช้ 1 คน กันคนยิง /api/chat รัว ๆ จนโควตา Gemini หมดและตาราง chat_history โตไม่หยุด
# นับตาม IP จริงของผู้ใช้ใน header CF-Connecting-IP ที่ Cloudflare หน้า Render ใส่มาให้ (ผู้ใช้ปลอมค่านี้เองไม่ได้)
# ค่าเริ่มต้น 20 ครั้ง/นาที (ตั้งใน Dockerfile) เปลี่ยนได้ที่หน้า Environment ของ service FE โดยไม่ต้องแก้โค้ด
# ถ้าไม่มี header นี้ (เช่นรันในเครื่อง) ค่าจะว่าง และ nginx จะไม่นับ request นั้น
limit_req_zone $http_cf_connecting_ip zone=chat:1m rate=${CHAT_RATE_PER_MIN}r/m;

server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;   # ถ้ามี redirect ให้ใช้ path อย่างเดียว (หลัง proxy ของ Render จะได้ไม่เด้งไป http://)

    # คำขอที่ขึ้นต้นด้วย /api/ ส่งต่อไปที่ BE ทั้ง path เช่น /api/chat → ${BE_URL}/api/chat
    # หน้าเว็บจึงเรียก fetch('/api/chat') ได้ตรง ๆ ไม่ต้องรู้ URL ของ BE และไม่ติด CORS
    # ^~ ทำให้ path /api/ ใช้ block นี้เสมอ ไม่ไปเข้า block ไฟล์ static ด้านล่าง
    location ^~ /api/ {
        limit_req zone=chat burst=10 nodelay;   # ส่งติดกันได้ 10 ครั้งก่อนเริ่มนับตามอัตรา
        limit_req_status 429;
        proxy_pass ${BE_URL};
        proxy_ssl_server_name on;   # ส่งชื่อโดเมนตอนต่อ HTTPS (Render ต้องใช้)
        proxy_read_timeout 90s;     # เผื่อ BE แบบฟรีกำลังตื่น หรือ Gemini ตอบช้า
    }

    # ไฟล์ JS/CSS ที่ Vite build มีเลข hash ในชื่อ (เช่น index-CT4_HQQQ.js) build ใหม่ได้ชื่อใหม่เสมอ
    # จึงให้เบราว์เซอร์เก็บไว้ได้ 1 ปี และถ้าไม่มีไฟล์ต้องตอบ 404 ไม่ใช่ index.html
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html ต้องถามเซิร์ฟเวอร์ใหม่ทุกครั้ง (ได้ 304 ถ้าไม่เปลี่ยน) หลัง deploy จะได้ชื่อไฟล์ JS ชุดใหม่ทันที
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # ไฟล์อื่นที่มีนามสกุล (ภาพใน /entry/ /room/, favicon) ถ้าไม่มีไฟล์ตอบ 404 จะได้เห็นว่า path ผิด
    location ~* \.(?:js|css|map|json|txt|webp|jpe?g|png|gif|svg|ico|woff2?)$ {
        try_files $uri =404;
    }

    # ทุก path อื่นตอบ index.html ให้ React จัดการเส้นทางเอง (รีเฟรชหน้า /room, /os แล้วไม่ขึ้น 404)
    # ไม่ใช้ $uri/ เพราะ /room กับ /entry เป็นทั้งหน้าในแอปและโฟลเดอร์ภาพใน public/
    # ถ้าใส่ไว้ nginx จะ redirect /room → /room/ แล้วตอบ 403 (โฟลเดอร์ไม่มี index.html)
    location / {
        try_files $uri /index.html;
    }

    # ส่งถี่เกินกำหนด: ตอบเป็น JSON แบบเดียวกับ BE หน้าแชตจะแสดงข้อความนี้
    error_page 429 = @too_many_requests;
    location @too_many_requests {
        default_type "application/json; charset=utf-8";
        return 429 '{"error":"ส่งข้อความถี่เกินไป รอสักครู่แล้วลองใหม่นะ"}';
    }
}
